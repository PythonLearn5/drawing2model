# Drawing2Model 运行配置示例
# 复制为 .env 并填入实际值: cp .env.example .env  (Windows: copy .env.example .env)
# 留空 LLM_API_KEY = 离线模式 (仅模板/规则, evolve 模式不可用)

# ---- LLM API (OpenAI 兼容) ----
LLM_API_KEY=
# 兼容别名 (老配置不破坏, 优先级低于 LLM_API_KEY)
#DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-max
# 可选: 分别覆盖视觉/文本模型 (不填则同 LLM_MODEL)
#LLM_VL_MODEL=
#LLM_TEXT_MODEL=

# ---- 运行时解释器 (Windows 开发机自建 venv 需指定) ----
# worker 沙箱解释器 (需装 cadquery + OCP)
D2M_WORKER_PY=./venv/Scripts/python.exe
# 工具脚本解释器 (stl2glb/渲染等, 可与 worker 同)
D2M_UTIL_PY=./venv/Scripts/python.exe
# worker 子进程 PYTHONPATH (Windows venv 模式留空; --target 安装时填目标目录)
#D2M_OCP_PYTHONPATH=

# ---- 独立 MCP 进程端口 (仅单独运行 mcp_server.py 时生效) ----
# server.py 已把 MCP SSE 挂在 /mcp 下与 REST 同端口, 通常无需单独跑
MCP_PORT=8411
